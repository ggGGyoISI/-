# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...

# Кому разрешено пользоваться ботом (твой Telegram user id, узнать можно у @userinfobot).
# Несколько через запятую. Пусто = бот доступен всем (не рекомендуется).
ADMIN_IDS=

# Канал по умолчанию для публикации (@username или -100...). Можно задать позже командой /channel.
CHANNEL=

# ---- Бесплатная нейросеть (любой OpenAI-совместимый API) ----
# Google Gemini — бесплатный ключ: https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Альтернатива — Groq (бесплатно, https://console.groq.com/keys):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# Альтернатива — локальная Ollama (полностью офлайн и бесплатно):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:14b

# ---- Прочее ----
# Часовой пояс для отложенных публикаций
TIMEZONE=Europe/Moscow
# Регион поиска DuckDuckGo
SEARCH_REGION=ru-ru
# Максимальная длина поста в символах (лимит Telegram — 4096)
MAX_POST_CHARS=2500

# ---- Картинки (бесплатно) ----
# pollinations — нейросеть без регистрации (по умолчанию)
# cloudflare   — Cloudflare Workers AI (FLUX), бесплатный дневной лимит, нужен аккаунт
# cover        — обложка с заголовком, рисуется на твоём компьютере, работает всегда
# none         — без картинок
# Если нейросеть не ответила, бот сам нарисует обложку.
IMAGE_PROVIDER=pollinations
IMAGE_STYLE=modern digital illustration, vibrant colors, high detail, no text, no letters
# Необязательно: бесплатный ключ после регистрации на pollinations.ai — меньше ограничений по частоте
POLLINATIONS_KEY=
POLLINATIONS_MODEL=
# Для IMAGE_PROVIDER=cloudflare (https://dash.cloudflare.com → AI → Workers AI):
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Шрифт для обложек (если в системе нет DejaVu/Arial)
FONT_PATH=

# ---- Автопилот ----
# Как часто искать новое (минуты)
AUTO_INTERVAL_MIN=60
# Сколько постов максимум за один проход (можно менять в боте: /auto 3)
AUTO_POSTS_PER_RUN=2
