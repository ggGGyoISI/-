# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...

# Кому разрешено пользоваться ботом (твой Telegram user id, узнать можно у @userinfobot).
# Несколько через запятую. Пусто = бот доступен всем (не рекомендуется).
ADMIN_IDS=

# Канал по умолчанию для публикации (@username или -100...). Можно задать позже командой /channel.
CHANNEL=

# ---- Бесплатная нейросеть (любой OpenAI-совместимый API) ----
# Google Gemini — бесплатный ключ: https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Альтернатива — Groq (бесплатно, https://console.groq.com/keys):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# Альтернатива — локальная Ollama (полностью офлайн и бесплатно):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:14b

# ---- Прочее ----
# Часовой пояс для отложенных публикаций
TIMEZONE=Europe/Moscow
# Регион поиска DuckDuckGo
SEARCH_REGION=ru-ru
# Максимальная длина поста в символах (лимит Telegram — 4096)
MAX_POST_CHARS=2500
