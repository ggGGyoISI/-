# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...

# Кому разрешено пользоваться ботом (твой Telegram user id, узнать можно у @userinfobot).
# Несколько через запятую. Пусто = бот доступен всем (не рекомендуется).
ADMIN_IDS=

# Канал по умолчанию для публикации (@username или -100...). Можно задать позже командой /channel.
CHANNEL=

# ---- Бесплатная нейросеть (любой OpenAI-совместимый API) ----
# Google Gemini — бесплатный ключ: https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Альтернатива — Groq (бесплатно, https://console.groq.com/keys):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# Альтернатива — локальная Ollama (полностью офлайн и бесплатно):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:14b

# ---- Прочее ----
# Часовой пояс для отложенных публикаций
TIMEZONE=Europe/Moscow
# Регион поиска DuckDuckGo
SEARCH_REGION=ru-ru
# Максимальная длина поста в символах (лимит Telegram — 4096)
MAX_POST_CHARS=2500

# ---- Картинки (бесплатно) ----
# Лучший бесплатный вариант — Cloudflare Workers AI (FLUX.2 [klein]):
# 10 000 бесплатных «нейронов» в день ≈ 90–100 картинок, без банковской карты.
# 1) Зарегистрируйся на https://dash.cloudflare.com
# 2) Account ID — на главной странице аккаунта (справа)
# 3) API-токен: My Profile → API Tokens → Create Token → шаблон «Workers AI»
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Модель:
#   @cf/black-forest-labs/flux-2-klein-4b — FLUX.2, быстро и красиво, ~95 картинок/день (по умолчанию)
#   @cf/black-forest-labs/flux-1-schnell  — FLUX.1, попроще, ~100 картинок/день
#   @cf/leonardo/lucid-origin             — Leonardo, самое высокое качество, но ~3 картинки/день
#   @cf/leonardo/phoenix-1.0              — Leonardo, ~4 картинки/день
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# Настоящие фото со стока Pexels (бесплатно, 200 запросов в час): https://www.pexels.com/api/
# С ключом под черновиком появится кнопка «📷 Фото со стока».
PEXELS_API_KEY=

# Порядок сервисов (через запятую), если первый не ответил — пробуется следующий:
#   auto         = cloudflare (если заданы ключи), потом pollinations
#   cloudflare, pexels, pollinations, cover (обложка с заголовком без нейросети), none (без картинок)
# Примеры: IMAGE_PROVIDER=pexels,cloudflare   — сначала реальные фото, потом нейросеть
IMAGE_PROVIDER=auto
# Писать заголовок поста поверх картинки (как у новостных каналов): on / off
IMAGE_TITLE=off
IMAGE_STYLE=modern digital illustration, vibrant colors, high detail, no text, no letters

# Pollinations.ai — запасной вариант без регистрации (медленнее, ~1 картинка в 15 сек)
POLLINATIONS_KEY=
POLLINATIONS_MODEL=
# Шрифт для обложек и заголовков (если в системе нет DejaVu/Arial)
FONT_PATH=

# ---- Автопилот ----
# Как часто искать новое (минуты)
AUTO_INTERVAL_MIN=60
# Сколько постов максимум за один проход (можно менять в боте: /auto 3)
AUTO_POSTS_PER_RUN=2
